# Optional for local UI preview: leave Firebase vars empty and run `npm run dev`
# — the app opens in "preview" mode (browser-only, no DB/API).

# PostgreSQL (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# After DATABASE_URL works locally, create tables:
#   npx prisma migrate dev --name init
# On Vercel, set the same env vars and use a build command that applies migrations, e.g.:
#   prisma migrate deploy && prisma generate && next build

# Firebase Admin — paste the full JSON of your service account as a single line string
# (Vercel: paste the JSON in the env var value; escape quotes if required by your host)
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'

# Firebase Web SDK (Firebase Console → Project settings → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
