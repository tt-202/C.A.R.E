# Pi arm server motion tuning (~30s full feed cycle with Jetson fast profile)
# Copy to .env on the Raspberry Pi:  cp .env.example .env

# Scoop trajectory wait multiplier (1.0 = original 4s steps; 0.55 ≈ 2.2s per step)
SCOOP_WAIT_SCALE=0.55

VIEW_SPEED=12
VIEW_SELECTION_WAIT=2.5
VIEW_MOUTH_WAIT=2.5
HOME_RETURN_WAIT=4.0

TRACK_SPEED=65
TRACK_STEP=2.5
ALIGN_PIXEL_THRESHOLD=25
ALIGN_DOMINANT_AXIS_ONLY=true
TRACK_LIMIT_MARGIN=0.01

APPROACH_STEP_Y=3.0
APPROACH_SPEED=12
