# Path to Firebase service account JSON (never commit this file).
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
ROBOT_ID=care-01

# false on Jetson when Pi + camera + ToF are ready (matches New_Settings_June26).
DRY_RUN=false

# Pi arm server (New_Settings_June26_raspberry/pi_arm_server.py)
PI_IP=192.168.50.2
PI_PORT=5002

# Mouth tracking (New_Settings_June26/main_controller_phase4.py)
CAMERA_ID=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
ARM_MOVE_SETTLE=1.0
CENTER_TOLERANCE=30
CENTER_HOLD_SECONDS=3.0
STOP_DISTANCE_CM=30.0
BITE_HOLD_SECONDS=5.0
APPROACH_COMMAND_PERIOD=0.20
MAX_APPROACH_SECONDS=6.0
USE_FAKE_TOF=false
FAKE_TOF_CM=60.0
SHOW_APRILTAG_PREVIEW=true
SHOW_MOUTH_PREVIEW=true
EMERGENCY_RECOVERY_SECONDS=10.0

# Local LCD GUI (New_Settings_June26/lcd_display.py)
LCD_GUI_ENABLED=true

# Physical buttons (BOARD pin numbers — same as June26)
BUTTONS_ENABLED=true
GPIO_PIN_MODE=BOARD
GPIO_PLATE_PIN=35
GPIO_FEED_PIN=37
GPIO_ESTOP_PIN=33
GPIO_DEBOUNCE_MS=80

# Hardware e-stop → caregiver push (must match Vercel ROBOT_SHARED_SECRET)
# CARE_APP_EMERGENCY_URL=https://your-app.vercel.app/api/robot/emergency
# CARE_ROBOT_SHARED_SECRET=long-random-secret
