# Path to Firebase service account JSON (never commit this file).
GOOGLE_APPLICATION_CREDENTIALS=/home/<your-user>/C.A.R.E/app/robot-worker/firebase-service-account.json
ROBOT_ID=care-01

# Set false when Pi arm server and camera are wired.
DRY_RUN=true

# Pi arm server (MyCobot 320 Pi) — Jetson sends TCP commands here.
PI_IP=192.168.50.2
PI_PORT=5001

# Mouth tracking (matches With_Emergency_Stop/main_controller_phase4.py)
CAMERA_ID=/dev/video0
CENTER_HOLD_SECONDS=3.0
STOP_DISTANCE_CM=5.0
DEAD_ZONE_PX=30
MOUTH_SESSION_TIMEOUT=90
USE_FAKE_TOF=false
FAKE_TOF_CM=60.0

# Physical buttons — BOARD pin numbers (same as working hardware)
BUTTONS_ENABLED=false
GPIO_FEED_PIN=33
GPIO_PLATE_PIN=35
GPIO_FEED_PIN=37
GPIO_ESTOP_PIN=33
GPIO_DEBOUNCE_MS=80

# Hardware e-stop → caregiver push (must match Vercel ROBOT_SHARED_SECRET)
# CARE_APP_EMERGENCY_URL=https://your-app.vercel.app/api/robot/emergency
# CARE_ROBOT_SHARED_SECRET=long-random-secret
