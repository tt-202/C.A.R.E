# Path to Firebase service account JSON (never commit this file).
GOOGLE_APPLICATION_CREDENTIALS=/home/<your-user>/C.A.R.E/app/robot-worker/firebase-service-account.json
ROBOT_ID=care-01

# Set false when Pi arm server is running and camera is wired.
DRY_RUN=true

# Pi arm server (MyCobot 320 Pi) — Jetson sends TCP commands here.
PI_IP=192.168.50.2
PI_PORT=5001

# Mouth tracking
CAMERA_ID=/dev/video0
FEED_STEPS_PER_BITE=6
STABLE_SECONDS=2.0
MOUTH_SESSION_TIMEOUT=90

# Physical buttons (BCM pins). Set false for Firebase-only desk testing.
BUTTONS_ENABLED=false
GPIO_FEED_PIN=33
GPIO_PLATE_PIN=35
GPIO_ESTOP_PIN=37
GPIO_DEBOUNCE_MS=80
