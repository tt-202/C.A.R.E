# Path to Firebase service account JSON (never commit this file).
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
ROBOT_ID=care-01

# false on Jetson when Pi + camera + ToF are ready.
DRY_RUN=false

# Pi arm server (app/pi-server/pi_arm_server.py)
PI_IP=192.168.50.2
PI_PORT=5002

# Mouth tracking + bite hold — tuned for ~30s full feed cycle
CAMERA_ID=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
ARM_MOVE_SETTLE=0.5
CENTER_TOLERANCE=30
CENTER_HOLD_SECONDS=1.5
STOP_DISTANCE_CM=50.0
STOP_DISTANCE_STABLE_SECONDS=1.0
BITE_HOLD_SECONDS=2.0
APPROACH_COMMAND_PERIOD=0.12
ALIGN_COMMAND_PERIOD=0.20
TRACK_LIMIT_GUI_COOLDOWN=1.0
MAX_APPROACH_SECONDS=8.0
LOOP_DELAY=0.02
MOUTH_TRACK_WIDTH=480
MOUTH_TRACK_HEIGHT=360
MOUTH_REFINE_LANDMARKS=false
MOUTH_MIN_DETECTION_CONFIDENCE=0.55
MOUTH_MIN_TRACKING_CONFIDENCE=0.55
FEED_CYCLE_TARGET_SECONDS=30
MOUTH_SESSION_TIMEOUT=0
USE_FAKE_TOF=false
FAKE_TOF_CM=60.0
SHOW_APRILTAG_PREVIEW=true
SHOW_MOUTH_PREVIEW=false
EMERGENCY_RECOVERY_SECONDS=10.0
# Seconds arm stays stopped after e-stop, then auto HOME (no release-button wait)

# Local LCD GUI
LCD_GUI_ENABLED=true

# Physical buttons (BOARD pin numbers)
BUTTONS_ENABLED=true
GPIO_PIN_MODE=BOARD
GPIO_PLATE_PIN=35
GPIO_FEED_PIN=37
GPIO_ESTOP_PIN=33
GPIO_DEBOUNCE_MS=80

# Hardware e-stop → caregiver push (must match Vercel ROBOT_SHARED_SECRET)
# CARE_APP_EMERGENCY_URL=https://your-app.vercel.app/api/robot/emergency
# CARE_APP_PLATE_ALERT_URL=https://your-app.vercel.app/api/robot/plate-alert
# CARE_ROBOT_SHARED_SECRET=long-random-secret

# YOLO plate/spoon — TensorRT engines (plate=best.engine, spoon=bestest.engine)
ENABLE_YOLO_CHECKS=true
YOLO_PLATE_MODEL_PATH=best.engine
YOLO_SPOON_MODEL_PATH=bestest.engine
SHOW_YOLO_PREVIEW=false
YOLO_FAIL_OPEN=false
MAX_FAILED_SCOOPS_PER_SECTION=3

# Manual override for scenario testing (auto | full | empty | unknown)
# auto = run real YOLO; full/empty/unknown = skip detector, force that result
FORCE_PLATE_STATUS=auto
FORCE_SPOON_STATUS=auto
SCOOP_YOLO_SETTLE_SECONDS=0.5
PLATE_YOLO_SETTLE_SECONDS=0.25
YOLO_PRELOAD=true
YOLO_MIN_VOTES=1
YOLO_PLATE_MIN_VOTES=1
YOLO_PLATE_SCAN_SECONDS=0.5
YOLO_PLATE_IMGSZ=416
YOLO_PLATE_SINGLE_SHOT_CONF=0.72
YOLO_CAMERA_WARMUP_FRAMES=2
YOLO_SPOON_SCAN_SECONDS=1.0
YOLO_CONFIDENCE=0.50
