# Path to Firebase service account JSON (robot worker — least privilege recommended).
#GOOGLE_APPLICATION_CREDENTIALS=/home/jetson/care-robot-sa.json
GOOGLE_APPLICATION_CREDENTIALS=/home/<your-user>/robot-worker/firebase-service-account.json
# Must match ROBOT_ID in Vercel / care-app .env
ROBOT_ID=care-01

# Set false when pymycobot is configured and the arm is connected.
DRY_RUN=true

# myCobot serial device (Jetson). Common: /dev/ttyAMA0 (UART) or /dev/ttyACM0 (USB)
MYCOBOT_PORT=/dev/ttyAMA0
MYCOBOT_BAUD=115200
