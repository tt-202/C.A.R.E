# Path to Firebase service account JSON (never commit this file).
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
ROBOT_ID=care-01

# Set false when Pi JSON arm server (port 5002) and camera are ready.
DRY_RUN=true

# Pi arm server — New_Settings_June26_raspberry/pi_arm_server.py
PI_IP=192.168.50.2
PI_PORT=5002

# Mouth tracking (New_Settings_June26/main_controller_phase4.py)
CAMERA_ID=/dev/video0
CENTER_HOLD_SECONDS=3.0
STOP_DISTANCE_CM=30.0
BITE_HOLD_SECONDS=5.0
DEAD_ZONE_PX=30
MOUTH_SESSION_TIMEOUT=90
USE_FAKE_TOF=false
FAKE_TOF_CM=60.0
EMERGENCY_RECOVERY_SECONDS=10.0

# Physical buttons — BOARD pin numbers
BUTTONS_ENABLED=false
GPIO_PIN_MODE=BOARD
GPIO_PLATE_PIN=35
GPIO_FEED_PIN=37
GPIO_ESTOP_PIN=33
GPIO_DEBOUNCE_MS=80

# Hardware e-stop → caregiver push (must match Vercel ROBOT_SHARED_SECRET)
# CARE_APP_EMERGENCY_URL=https://your-app.vercel.app/api/robot/emergency
# CARE_ROBOT_SHARED_SECRET=long-random-secret
