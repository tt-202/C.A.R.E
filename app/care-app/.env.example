# Optional for local UI preview: leave Firebase vars empty and run `npm run dev`
# — the app opens in "preview" mode (browser-only, no DB/API).

# PostgreSQL (Neon, Vercel Postgres, Supabase, etc.)
# Neon: use the *pooler* host and include pgbouncer=true (required for Prisma):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/DB?sslmode=require&pgbouncer=true"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&pgbouncer=true"

# After DATABASE_URL works locally, create tables:
#   npx prisma migrate dev --name init
# For care pairs (linked accounts):
#   npx prisma migrate deploy   # or: npx prisma db push
# On Vercel, set the same env vars and use a build command that applies migrations, e.g.:
#   prisma migrate deploy && prisma generate && next build

# Firebase Admin — download JSON from Firebase Console → Project settings → Service accounts
# → Generate new private key. Paste the ENTIRE file as ONE line in .env (keep "private_key" with \n).
# On Vercel: paste the raw JSON into the env var value (no extra quotes).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}

# Capacitor iOS/Android: WebView loads this HTTPS URL (your Vercel deployment). No trailing slash.
# CAPACITOR_SERVER_URL=https://your-app.vercel.app

# Optional: same as above if you already use a public canonical app URL for the web app.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Firebase Web SDK (Firebase Console → Project settings → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push (FCM) — Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Generate key pair
# Paste the public key (starts with B...) into Vercel/local .env:
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Meal-reminder cron: set CRON_SECRET, then call GET /api/cron/meal-reminders with header
# Authorization: Bearer <CRON_SECRET> every few minutes (e.g. cron-job.org on Vercel Hobby).
# Vercel built-in cron needs Pro for schedules more than once per day — not in vercel.json.
# CRON_SECRET=
# Optional default IANA timezone for care pairs without timezone saved (e.g. America/New_York).
# CARE_DEFAULT_TIMEZONE=America/New_York

# Robot bridge (Firestore → Jetson worker). Enable after Firestore + robot-worker are running.
# ROBOT_ID=care-01
# NEXT_PUBLIC_ROBOT_ID=care-01
# NEXT_PUBLIC_ROBOT_ENABLED=true

# Jetson hardware e-stop + YOLO plate-empty → caregiver push
# ROBOT_SHARED_SECRET=long-random-secret-must-match-jetson-CARE_ROBOT_SHARED_SECRET
# ROBOT_CARE_PAIR_ID=your-firestore-care-pair-id
# ROBOT_CARE_RECIPIENT_NAME=C.A.R.E User
# ROBOT_CAREGIVER_NAME=Caregiver
# Jetson .env: CARE_APP_EMERGENCY_URL, CARE_APP_PLATE_ALERT_URL, CARE_ROBOT_SHARED_SECRET
