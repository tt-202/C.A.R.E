generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CareMemberRole {
  caregiver
  user
}

model User {
  id                 String   @id @default(cuid())
  firebaseUid        String   @unique
  email              String   @default("")
  displayName        String   @default("")
  /** Legacy profile fields — migrated to CarePair when possible. */
  careRecipientName  String   @default("")
  caregiverName      String   @default("")
  breakfastTime      String   @default("08:00")
  lunchTime          String   @default("12:30")
  dinnerTime         String   @default("18:00")
  meals              Meal[]
  createdAt          DateTime @default(now())
}

model CarePair {
  id                String           @id @default(cuid())
  careRecipientName String           @default("")
  caregiverName     String           @default("")
  breakfastTime     String           @default("08:00")
  lunchTime         String           @default("12:30")
  dinnerTime        String           @default("18:00")
  members           CarePairMember[]
  invites           CareInvite[]
  meals             Meal[]
  createdAt         DateTime         @default(now())
}

model CarePairMember {
  id          String         @id @default(cuid())
  carePairId  String
  carePair    CarePair       @relation(fields: [carePairId], references: [id], onDelete: Cascade)
  firebaseUid String         @unique
  role        CareMemberRole
  email       String         @default("")
  createdAt   DateTime       @default(now())

  @@index([carePairId])
  @@index([carePairId, role])
}

model CareInvite {
  id            String         @id @default(cuid())
  carePairId    String
  carePair      CarePair       @relation(fields: [carePairId], references: [id], onDelete: Cascade)
  code          String         @unique
  role          CareMemberRole
  createdByUid  String
  expiresAt     DateTime
  acceptedAt    DateTime?
  acceptedByUid String?
  createdAt     DateTime       @default(now())

  @@index([carePairId])
}

model Meal {
  id              String    @id @default(cuid())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  carePairId      String?
  carePair        CarePair? @relation(fields: [carePairId], references: [id], onDelete: Cascade)
  startedAt       DateTime
  endedAt         DateTime?
  durationMs      Int?
  plannedMealTime String?
  bitesTotal      Int       @default(0)
  section1Count   Int       @default(0)
  section2Count   Int       @default(0)
  section3Count   Int       @default(0)
  section4Count   Int       @default(0)
  bites           MealBite[]

  @@index([userId])
  @@index([carePairId])
}

model MealBite {
  id         String   @id @default(cuid())
  mealId     String
  meal       Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  sectionNum Int
  createdAt  DateTime @default(now())

  @@index([mealId])
}
