#!/usr/bin/env python3
"""
apriltag_plate.py

AprilTag plate calibration module for C.A.R.E.

This file:
- Opens the USB camera
- Detects AprilTags ID 0, 1, 2, 3
- Does NOT show a camera preview window by default
- Includes the preview code, but it is commented out for now
- Waits until all four tags are visible at the same time
- Calculates:
    - each tag center
    - plate center
    - section 1 center
    - section 2 center
    - section 3 center
    - section 4 center
- Saves the result to plate_coordinates.py
- Returns the result so main.py can use it
"""

import cv2
import os
import time
import numpy as np
from pupil_apriltags import Detector


# -----------------------------
# Settings
# -----------------------------

EXPECTED_TAG_IDS = [0, 1, 2, 3]

COORDINATE_FILE = "plate_coordinates.py"

CAMERA_INDEX = 0
CAMERA_WIDTH = 640
CAMERA_HEIGHT = 480
CAMERA_FPS = 30


# -----------------------------
# Helper Functions
# -----------------------------

def get_tag_center(tag):
    """
    Get the center pixel coordinate of one AprilTag.

    Returns:
        (x, y)
    """
    return int(tag.center[0]), int(tag.center[1])


def midpoint(p1, p2):
    """
    Find midpoint between two pixel coordinates.
    """
    return ((p1[0] + p2[0]) // 2, (p1[1] + p2[1]) // 2)


def draw_section_center(frame, section_name, section_center):
    """
    Draw the calculated section center on the frame.

    This is useful when preview/debug window is enabled.
    """
    cv2.circle(frame, section_center, 8, (255, 0, 255), -1)

    cv2.putText(
        frame,
        f"{section_name}: {section_center}",
        (section_center[0] - 90, section_center[1] - 10),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.45,
        (255, 0, 255),
        2
    )


def save_coordinates(coordinates, coordinate_file=COORDINATE_FILE):
    """
    Save plate calibration coordinates to a Python file.

    This version overwrites the file every time the calibration runs.
    This is useful because the AprilTag calibration should only be called once
    during system startup.
    """

    with open(coordinate_file, "w") as f:
        f.write("# Auto-generated by apriltag_plate.py\n")
        f.write("# This file is overwritten every time calibration runs.\n\n")

        f.write(f"TAG_0 = {coordinates['tags'][0]}\n")
        f.write(f"TAG_1 = {coordinates['tags'][1]}\n")
        f.write(f"TAG_2 = {coordinates['tags'][2]}\n")
        f.write(f"TAG_3 = {coordinates['tags'][3]}\n\n")

        f.write(f"PLATE_CENTER = {coordinates['plate_center']}\n")
        f.write(f"SECTION_1 = {coordinates['sections'][1]}\n")
        f.write(f"SECTION_2 = {coordinates['sections'][2]}\n")
        f.write(f"SECTION_3 = {coordinates['sections'][3]}\n")
        f.write(f"SECTION_4 = {coordinates['sections'][4]}\n")

    print(f"Coordinates saved/overwritten successfully to {coordinate_file}.")
    return True


def calculate_plate_coordinates(tag_centers):
    """
    Calculate plate center and section centers from four AprilTag centers.

    Tag layout expected:
        tag 0 -> tag 1
          |       |
        tag 3 <- tag 2
    """
    p0 = tag_centers[0]
    p1 = tag_centers[1]
    p2 = tag_centers[2]
    p3 = tag_centers[3]

    plate_center = (
        (p0[0] + p1[0] + p2[0] + p3[0]) // 4,
        (p0[1] + p1[1] + p2[1] + p3[1]) // 4
    )

    edge_01 = midpoint(p0, p1)
    edge_12 = midpoint(p1, p2)
    edge_23 = midpoint(p2, p3)
    edge_30 = midpoint(p3, p0)

    section1_center = midpoint(plate_center, edge_01)
    section2_center = midpoint(plate_center, edge_12)
    section3_center = midpoint(plate_center, edge_23)
    section4_center = midpoint(plate_center, edge_30)

    coordinates = {
        "tags": {
            0: p0,
            1: p1,
            2: p2,
            3: p3,
        },
        "plate_center": plate_center,
        "sections": {
            1: section1_center,
            2: section2_center,
            3: section3_center,
            4: section4_center,
        }
    }

    return coordinates


def draw_debug_overlay(frame, tag_centers, coordinates=None):
    """
    Draw tag outlines, tag centers, plate center, and section centers.

    This only matters if the preview window is enabled.
    """
    for tag_id, center in tag_centers.items():
        cx, cy = center

        cv2.circle(frame, (cx, cy), 5, (0, 0, 255), -1)

        cv2.putText(
            frame,
            f"ID {tag_id}",
            (cx - 25, cy - 30),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            (0, 255, 0),
            2
        )

    if coordinates is not None:
        p0 = coordinates["tags"][0]
        p1 = coordinates["tags"][1]
        p2 = coordinates["tags"][2]
        p3 = coordinates["tags"][3]

        plate_center = coordinates["plate_center"]

        cv2.circle(frame, plate_center, 7, (0, 255, 255), -1)

        cv2.putText(
            frame,
            f"Plate Center: {plate_center}",
            (plate_center[0] + 10, plate_center[1]),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.55,
            (0, 255, 255),
            2
        )

        cv2.line(frame, p0, p1, (255, 0, 0), 2)
        cv2.line(frame, p1, p2, (255, 0, 0), 2)
        cv2.line(frame, p2, p3, (255, 0, 0), 2)
        cv2.line(frame, p3, p0, (255, 0, 0), 2)

        cv2.line(frame, plate_center, p0, (0, 255, 255), 2)
        cv2.line(frame, plate_center, p1, (0, 255, 255), 2)
        cv2.line(frame, plate_center, p2, (0, 255, 255), 2)
        cv2.line(frame, plate_center, p3, (0, 255, 255), 2)

        draw_section_center(frame, "Section 1", coordinates["sections"][1])
        draw_section_center(frame, "Section 2", coordinates["sections"][2])
        draw_section_center(frame, "Section 3", coordinates["sections"][3])
        draw_section_center(frame, "Section 4", coordinates["sections"][4])
    else:
        cv2.putText(
            frame,
            "Waiting for tags ID 0, 1, 2, 3...",
            (20, 40),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (0, 0, 255),
            2
        )


# -----------------------------
# Main Detection Function
# -----------------------------

def get_initial_plate_coordinates(
    camera_index=CAMERA_INDEX,
    timeout_seconds=20,
    save_to_file=True
):
    """
    Detect all four AprilTags once and return the initial plate coordinates.

    This is the function your future main system should call.

    Returns:
        {
            "tags": {
                0: (x, y),
                1: (x, y),
                2: (x, y),
                3: (x, y)
            },
            "plate_center": (x, y),
            "sections": {
                1: (x, y),
                2: (x, y),
                3: (x, y),
                4: (x, y)
            }
        }

    Important:
        These are image pixel coordinates, not robot-world coordinates.
    """

    at_detector = Detector(families="tag36h11")

    cap = cv2.VideoCapture(camera_index)

    cap.set(cv2.CAP_PROP_FRAME_WIDTH, CAMERA_WIDTH)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, CAMERA_HEIGHT)
    cap.set(cv2.CAP_PROP_FPS, CAMERA_FPS)

    if not cap.isOpened():
        raise RuntimeError("Error: Could not open USB camera.")

    print("--- AprilTag Plate Calibration Active ---")
    print("Preview window code is included but commented out for now.")
    print("Waiting until tags 0, 1, 2, and 3 are all visible...")

    # -------------------------------------------------
    # Preview window setup
    # Uncomment this later if you want the window back.
    # -------------------------------------------------
    cv2.namedWindow("Plate Section Calibration", cv2.WINDOW_AUTOSIZE)

    start_time = time.time()

    try:
        while True:
            elapsed_time = time.time() - start_time

            if elapsed_time > timeout_seconds:
                raise TimeoutError(
                    f"Timed out after {timeout_seconds} seconds. "
                    "Could not detect all four AprilTags."
                )

            success, frame = cap.read()

            if not success:
                raise RuntimeError("Failed to read frame from camera.")

            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

            results = at_detector.detect(gray)

            tag_centers = {}

            for r in results:
                tag_id = r.tag_id

                if tag_id in EXPECTED_TAG_IDS:
                    cx, cy = get_tag_center(r)
                    tag_centers[tag_id] = (cx, cy)

                    # This draws the green AprilTag outline.
                    # It will only matter if the preview window is enabled.
                    corners = np.array(r.corners, dtype=np.int32)
                    cv2.polylines(frame, [corners], True, (0, 255, 0), 2)

            coordinates = None

            if all(tag_id in tag_centers for tag_id in EXPECTED_TAG_IDS):
                coordinates = calculate_plate_coordinates(tag_centers)

                # Draw full overlay before returning.
                # This only matters if the preview window is enabled.
                draw_debug_overlay(frame, tag_centers, coordinates)

                print("All four AprilTags detected.")
                print("Initial plate coordinates calculated.")

                if save_to_file:
                    save_coordinates(coordinates)
                # -------------------------------------------------
                # Preview window display
                # Uncomment these two lines later if you want to see
                # the final detected frame before returning.
                # -------------------------------------------------
                cv2.imshow("Plate Section Calibration", frame)
                cv2.waitKey(1000)

                return coordinates

            else:
                # Draw waiting message before looping again.
                # This only matters if the preview window is enabled.
                draw_debug_overlay(frame, tag_centers, coordinates=None)

            # -------------------------------------------------
            # Live preview display
            # Uncomment this block later if you want the window back.
            # -------------------------------------------------
            cv2.imshow("Plate Section Calibration", frame)
            
            if cv2.waitKey(1) & 0xFF == ord("q"):
                raise KeyboardInterrupt("Calibration stopped by user.")

    finally:
        cap.release()

        # -------------------------------------------------
        # Preview window cleanup
        # Uncomment this later if you enable the preview window.
        # -------------------------------------------------
        cv2.destroyAllWindows()