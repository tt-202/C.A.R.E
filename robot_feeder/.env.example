GOOGLE_APPLICATION_CREDENTIALS=/home/jetson/care-robot-sa.json
ROBOT_ID=care-01
DRY_RUN=true
MYCOBOT_PORT=/dev/ttyACM0
MYCOBOT_BAUD=115200
CAMERA_DEVICE_ID=0
YOLO_MODEL_PATH=perception/best.pt
FEEDER_LOOP_HZ=10
TOF_MOCK_MM=200

# GPIO buttons (BCM). Enable on Jetson after wiring feed / plate / e-stop.
BUTTONS_ENABLED=false
GPIO_FEED_PIN=17
GPIO_PLATE_PIN=27
GPIO_ESTOP_PIN=22
GPIO_DEBOUNCE_MS=80

# AprilTag on 4-part plate: tag ID → section 1–4 (print tags tag36h11)
APRILTAG_ENABLED=true
APRILTAG_FAMILY=tag36h11
# Physical tag ID : plate section
APRILTAG_SECTION_MAP=1:1,2:2,3:3,4:4

# Operator LCD / HDMI monitor (lcd_display.py style — jetson_controller/gui)
GUI_ENABLED=true
# GUI_FULLSCREEN=true
# GUI_IMAGE_DIR=gui/images
